{
  "name": "Grocery Share",
  "short_name": "Grocery Share",
  "description": "Kassenbons per KI analysieren und fair zwischen zwei Personen aufteilen.",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#0b1020",
  "theme_color": "#0b1020",
  "categories": ["finance", "shopping", "productivity"],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "files", "accept": ["image/*", "application/pdf", ".pdf"] }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html?share=1",
      "accept": { "image/*": [".jpg", ".jpeg", ".png", ".webp"], "application/pdf": [".pdf"] }
    }
  ],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
